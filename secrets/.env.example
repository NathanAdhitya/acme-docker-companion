# acmed configuration. Copy to secrets/.env and fill in.
#
# Secrets may also be supplied as files: for any variable FOO, setting FOO_FILE
# to a path makes acmed (and most lego DNS providers) read the value from that
# file. This is the preferred way to use Docker secrets.

# ---------------------------------------------------------------------------
# Certificate authorities (ordered active/backup chain)
# ---------------------------------------------------------------------------
# First entry is the primary; acmed fails over in order. Names may be lego CA
# codes (letsencrypt, letsencrypt-staging, googletrust, googletrust-staging,
# zerossl, sectigo, ...) or friendly aliases (gts = googletrust, le = letsencrypt).
ACME_CA_ORDER=letsencrypt

# Contact email used for every CA that does not override it.
ACME_DEFAULT_EMAIL=admin@example.com

# Per-CA overrides (replace LETSENCRYPT with the upper-cased CA name):
# ACME_LETSENCRYPT_URL=googletrust            # a code or a full directory URL
# ACME_LETSENCRYPT_EMAIL=ops@example.com
# ACME_LETSENCRYPT_EAB_KID=...
# ACME_LETSENCRYPT_EAB_HMAC_FILE=/run/secrets/eab_hmac
# ACME_LETSENCRYPT_ACCOUNT_KEY_FILE=/run/secrets/account.key

# Issue against staging endpoints. Known production codes are rewritten to
# their staging counterparts; CAs without a staging endpoint are skipped.
# ACME_STAGING=true

# Certificate key type (EC256, EC384, RSA2048, RSA3072, RSA4096) and optional
# ACME certificate profile (e.g. shortlived) / preferred chain.
ACME_KEY_TYPE=EC256
# ACME_PROFILE=shortlived
# ACME_PREFERRED_CHAIN=ISRG Root X1

# Extra trust anchors (PEM path list) and optional TLS SNI override for private
# ACME servers such as Pebble or step-ca.
# ACME_CA_CERT=/run/secrets/private-ca.pem
# ACME_CA_SERVER_NAME=localhost

# ---------------------------------------------------------------------------
# DNS-01 (the only supported challenge type)
# ---------------------------------------------------------------------------
# lego provider name, e.g. cloudflare, route53, digitalocean, gandi, hetzner,
# acmedns, exec. Provider credentials use the provider's own variables, and
# most support a _FILE suffix.
ACME_DNS_PROVIDER=cloudflare
# CF_DNS_API_TOKEN=...
# CF_DNS_API_TOKEN_FILE=/run/secrets/cf_dns_api_token

# Recursive resolvers used for propagation checks. Docker's embedded DNS
# (127.0.0.11) can be flaky, so explicit resolvers are recommended.
ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53

# For split-horizon or test setups only:
# ACME_DNS_DISABLE_AUTHORITATIVE_CHECK=true
# ACME_DNS_PROPAGATION_WAIT=10s

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# DOCKER_HOST=unix:///var/run/docker.sock
STATE_DIR=/data
CHECK_INTERVAL=12h
# RENEW_BEFORE=720h
FAILURE_BACKOFF=1m,10m,100m,24h
MAX_CONCURRENT_ISSUANCE=2

# Ownership/permissions of delivered files. Non-root target containers need
# FILE_UID/FILE_GID set (and often a readable key mode).
FILE_UID=0
FILE_GID=0
FILE_MODE=0644
KEY_MODE=0640

LABEL_PREFIX=acmed
LOG_LEVEL=info
HTTP_ADDR=:8080
